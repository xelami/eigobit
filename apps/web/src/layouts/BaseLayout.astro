---
import "../styles/global.css"

interface Props {
  title?: string
}

const { title = "英語ビット" } = Astro.props
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-[var(--background)] text-[var(--foreground)]">
    <slot />
  </body>
</html>
