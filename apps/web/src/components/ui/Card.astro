---
interface Props {
  padding?: "none" | "sm" | "md" | "lg";
  hover?: boolean;
  class?: string;
}

const {
  padding = "md",
  hover = false,
  class: className = "",
} = Astro.props;

const paddingClasses = {
  none: "p-0",
  sm: "p-4",
  md: "p-6",
  lg: "p-8",
};

const classes = [
  "rounded-xl border border-[var(--border)] bg-[var(--card)] shadow-sm",
  paddingClasses[padding],
  hover
    ? "transition-shadow hover:shadow-md"
    : "",
  className,
].join(" ");
---

<div class={classes}>
  <slot />
</div>