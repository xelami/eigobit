---
interface Props {
  name: string;
  label?: string;
  type?: "text" | "email" | "password" | "number" | "search";
  placeholder?: string;
  value?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  autocomplete?: string;
}

const {
  name,
  label,
  type = "text",
  placeholder,
  value,
  required = false,
  disabled = false,
  error,
  autocomplete,
} = Astro.props;

const inputId = `input-${name}`;
---

<div class="space-y-2">
  {
    label && (
      <label
        for={inputId}
        class="block text-sm font-medium text-[var(--foreground)]"
      >
        {label}

        {required && (
          <span class="ml-1 text-[var(--danger)]">
            *
          </span>
        )}
      </label>
    )
  }

  <input
    id={inputId}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    autocomplete={autocomplete}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={error ? `${inputId}-error` : undefined}
    class:list={[
      "w-full rounded-lg border bg-[var(--card)] px-3.5 py-2.5 text-sm text-[var(--foreground)] outline-none transition",
      "placeholder:text-[var(--muted)]",
      "focus:ring-2 focus:ring-[var(--primary)]/20",
      error
        ? "border-[var(--danger)] focus:border-[var(--danger)]"
        : "border-[var(--border)] focus:border-[var(--primary)]",
      "disabled:cursor-not-allowed disabled:bg-slate-50 disabled:opacity-60",
    ]}
  />

  {
    error && (
      <p
        id={`${inputId}-error`}
        class="text-sm text-[var(--danger)]"
      >
        {error}
      </p>
    )
  }
</div>