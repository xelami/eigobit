---
import {
  englishLevelLabels,
  goalLabels,
  studyTimeLabels,
} from "../../lib/settings/labels"

const { preferences } = Astro.props
---

<section class="mt-6 rounded-2xl border bg-white p-6 sm:p-8">
  <div
    class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
  >
    <div>
      <h2 class="text-xl font-bold text-gray-900">学習設定</h2>

      <p class="mt-1 text-sm text-gray-500">
        あなたに合った学習体験を提供するための設定です。
      </p>
    </div>

    <button
      id="edit-preferences-button"
      type="button"
      class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
    >
      編集
    </button>
  </div>

  <div id="preferences-display" class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl bg-gray-50 p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
        英語レベル
      </p>

      <p id="display-english-level" class="mt-2 font-semibold text-gray-900">
        {
          preferences.englishLevel
            ? (englishLevelLabels[preferences.englishLevel] ??
              preferences.englishLevel)
            : "未設定"
        }
      </p>
    </div>

    <div class="rounded-xl bg-gray-50 p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
        1日の学習時間
      </p>

      <p id="display-study-time" class="mt-2 font-semibold text-gray-900">
        {
          preferences.studyTime
            ? (studyTimeLabels[preferences.studyTime] ?? preferences.studyTime)
            : "未設定"
        }
      </p>
    </div>

    <div class="rounded-xl bg-gray-50 p-5 sm:col-span-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
        学習目標
      </p>

      <div id="display-learning-goals" class="mt-3 flex flex-wrap gap-2">
        {
          preferences.learningGoals.length > 0 ? (
            preferences.learningGoals.map((goal: any) => (
              <span class="rounded-full border bg-white px-3 py-1.5 text-sm font-medium text-gray-700">
                {goalLabels[goal] ?? goal}
              </span>
            ))
          ) : (
            <span class="font-semibold text-gray-900">未設定</span>
          )
        }
      </div>
    </div>

    <div class="rounded-xl bg-gray-50 p-5 sm:col-span-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
        興味・関心
      </p>

      <div id="display-interests" class="mt-3 flex flex-wrap gap-2">
        {
          preferences.interests.length > 0 ? (
            preferences.interests.map((interest: any) => (
              <span class="rounded-full border bg-white px-3 py-1.5 text-sm font-medium text-gray-700">
                {interest}
              </span>
            ))
          ) : (
            <span class="font-semibold text-gray-900">未設定</span>
          )
        }
      </div>
    </div>
  </div>

  <div id="preferences-editor" class="mt-6 hidden space-y-6">
    <div>
      <label
        for="english-level"
        class="block text-sm font-semibold text-gray-900"
      >
        英語レベル
      </label>

      <select
        id="english-level"
        class="mt-2 w-full rounded-lg border-gray-300 bg-white px-3 py-2 text-sm sm:max-w-md"
      >
        {
          Object.entries(englishLevelLabels).map(([value, label]) => (
            <option value={value} selected={preferences.englishLevel === value}>
              {label}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="study-time" class="block text-sm font-semibold text-gray-900">
        1日の学習時間
      </label>

      <select
        id="study-time"
        class="mt-2 w-full rounded-lg border-gray-300 bg-white px-3 py-2 text-sm sm:max-w-md"
      >
        {
          Object.entries(studyTimeLabels).map(([value, label]) => (
            <option value={value} selected={preferences.studyTime === value}>
              {label}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <p class="text-sm font-semibold text-gray-900">学習目標</p>

      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        {
          Object.entries(goalLabels).map(([value, label]) => (
            <label class="flex items-center gap-3 rounded-lg border p-3">
              <input
                type="checkbox"
                name="learning-goal"
                value={value}
                checked={preferences.learningGoals.includes(value)}
                class="rounded border-gray-300"
              />
              <span class="text-sm font-medium text-gray-700">{label}</span>
            </label>
          ))
        }
      </div>
    </div>

    <div>
      <label for="interests" class="block text-sm font-semibold text-gray-900">
        興味・関心
      </label>

      <input
        id="interests"
        type="text"
        value={preferences.interests.join(", ")}
        placeholder="音楽、サッカー、テクノロジーなど"
        class="mt-2 w-full rounded-lg border-gray-300 px-3 py-2 text-sm"
      />

      <p class="mt-1 text-xs text-gray-500">
        複数ある場合は、カンマ（,）で区切ってください。
      </p>
    </div>

    <div class="flex justify-end gap-3 border-t pt-5">
      <button
        id="cancel-preferences-button"
        type="button"
        class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50"
      >
        キャンセル
      </button>

      <button
        id="save-preferences-button"
        type="button"
        class="rounded-lg bg-gray-900 px-5 py-2 text-sm font-semibold text-white hover:bg-gray-800"
      >
        変更を保存
      </button>
    </div>

    <div id="preferences-message" class="hidden rounded-lg px-4 py-3 text-sm">
    </div>
  </div>
</section>
<script>
  const editButton = document.getElementById("edit-preferences-button")
  const cancelButton = document.getElementById("cancel-preferences-button")
  const saveButton = document.getElementById("save-preferences-button")

  const display = document.getElementById("preferences-display")
  const editor = document.getElementById("preferences-editor")
  const message = document.getElementById("preferences-message")

  editButton?.addEventListener("click", () => {
    display?.classList.add("hidden")
    editor?.classList.remove("hidden")
    editButton.classList.add("hidden")
  })

  cancelButton?.addEventListener("click", () => {
    window.location.reload()
  })

  saveButton?.addEventListener("click", async () => {
    const englishLevel = (
      document.getElementById("english-level") as HTMLSelectElement
    )?.value

    const studyTime = (
      document.getElementById("study-time") as HTMLSelectElement
    )?.value

    const learningGoals = Array.from(
      document.querySelectorAll<HTMLInputElement>(
        'input[name="learning-goal"]:checked',
      ),
    ).map((input) => input.value)

    const interests = (
      document.getElementById("interests") as HTMLInputElement
    )?.value
      .split(",")
      .map((interest) => interest.trim())
      .filter(Boolean)

    if (learningGoals.length === 0) {
      if (message) {
        message.textContent = "学習目標を1つ以上選択してください。"

        message.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        message.classList.remove("hidden")
      }

      return
    }

    saveButton.setAttribute("disabled", "true")
    saveButton.textContent = "保存中..."

    try {
      const response = await fetch("/api/settings/preferences", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          englishLevel,
          studyTime,
          learningGoals,
          interests,
        }),
      })

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error ?? "学習設定の保存に失敗しました")
      }

      window.location.reload()
    } catch (error) {
      if (message) {
        message.textContent =
          error instanceof Error
            ? error.message
            : "学習設定の保存に失敗しました。"

        message.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        message.classList.remove("hidden")
      }

      saveButton.removeAttribute("disabled")
      saveButton.textContent = "変更を保存"
    }
  })
</script>
