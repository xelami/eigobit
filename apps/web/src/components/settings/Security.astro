---

---

<section class="mt-6 rounded-2xl border bg-white p-6 sm:p-8">
  <div>
    <h2 class="text-xl font-bold text-gray-900">アカウントとセキュリティ</h2>
    <p class="mt-1 text-sm text-gray-500">
      パスワードやアカウントのセッションを管理します。
    </p>
  </div>

  <div class="mt-6 divide-y">
    <div class="flex items-center justify-between gap-6 py-4 first:pt-0">
      <div>
        <p class="font-semibold text-gray-900">パスワード</p>
        <p class="mt-1 text-sm text-gray-500">
          アカウントのパスワードを変更します。
        </p>
      </div>

      <button
        type="button"
        class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
      >
        パスワードを変更
      </button>
    </div>

    <div class="flex items-center justify-between gap-6 py-4">
      <div>
        <p class="font-semibold text-gray-900">ログアウト</p>
        <p class="mt-1 text-sm text-gray-500">
          現在のセッションからログアウトします。
        </p>
      </div>

      <a
        href="/logout"
        class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
      >
        ログアウト
      </a>
    </div>
  </div>
</section>
