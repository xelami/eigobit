---

---

<section class="mt-6 rounded-2xl border border-red-200 bg-white p-6 sm:p-8">
  <div>
    <h2 class="text-xl font-bold text-red-700">危険な操作</h2>

    <p class="mt-1 text-sm text-gray-500">
      これらの操作はアカウントに永久的な影響を与える可能性があります。
    </p>
  </div>

  <div
    class="mt-6 flex flex-col gap-4 rounded-xl border border-red-100 bg-red-50 p-5 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <p class="font-semibold text-gray-900">アカウントを削除</p>

      <p class="mt-1 text-sm text-gray-600">
        アカウントと関連するすべての学習データを完全に削除します。
      </p>
    </div>

    <button
      id="open-delete-account-modal"
      type="button"
      class="shrink-0 rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-100"
    >
      アカウントを削除
    </button>
  </div>
</section>
<div
  id="delete-account-modal"
  class="fixed inset-0 z-50 hidden"
  aria-labelledby="delete-account-title"
  aria-modal="true"
  role="dialog"
>
  <!-- Backdrop -->

  <div
    id="delete-account-backdrop"
    class="absolute inset-0 bg-black/50 backdrop-blur-sm"
  >
  </div>

  <!-- Modal -->

  <div class="relative flex min-h-full items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl sm:p-8">
      <!-- Header -->

      <div>
        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-100 text-red-700"
        >
          !
        </div>

        <h2
          id="delete-account-title"
          class="mt-5 text-xl font-bold text-gray-900"
        >
          アカウントを削除しますか？
        </h2>

        <p class="mt-2 text-sm leading-6 text-gray-600">
          この操作は永久的なもので、元に戻すことはできません。
        </p>
      </div>

      <!-- Warning -->

      <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4">
        <p class="text-sm font-semibold text-red-800">
          以下の情報が完全に削除されます：
        </p>

        <ul class="mt-3 space-y-2 text-sm leading-5 text-red-700">
          <li>• アカウントおよびプロフィール情報</li>
          <li>• 学習設定および興味・関心</li>
          <li>• TOEIC・英検の目標</li>
          <li>• 練習セッションおよび結果</li>
          <li>• 保存した単語および学習データ</li>
          <li>• 連携済みGoogle / OAuthアカウント情報</li>
          <li>• 現在ログイン中のセッション</li>
        </ul>
      </div>

      <p class="mt-5 text-sm leading-6 text-gray-600">
        アカウントを削除すると、データを復元することはできません。
      </p>

      <!-- Confirmation -->

      <label
        class="mt-6 flex cursor-pointer items-start gap-3 rounded-xl border p-4 transition hover:bg-gray-50"
      >
        <input
          id="delete-account-confirmation"
          type="checkbox"
          class="mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-red-600 focus:ring-red-500"
        />

        <span class="text-sm font-medium leading-5 text-gray-700">
          アカウントと関連するすべてのデータが完全に削除され、復元できないことを理解しました。
        </span>
      </label>

      <!-- Error -->

      <div
        id="delete-account-message"
        class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
      >
      </div>

      <!-- Actions -->

      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button
          id="cancel-delete-account"
          type="button"
          class="rounded-lg border px-5 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
        >
          キャンセル
        </button>

        <button
          id="confirm-delete-account"
          type="button"
          disabled
          class="rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-40"
        >
          アカウントを完全に削除
        </button>
      </div>
    </div>
  </div>
</div>
<script>
  /*
   * ==========================================================================
   * アカウント削除
   * ==========================================================================
   */

  const openDeleteAccountModal = document.getElementById(
    "open-delete-account-modal",
  )

  const deleteAccountModal = document.getElementById("delete-account-modal")

  const deleteAccountBackdrop = document.getElementById(
    "delete-account-backdrop",
  )

  const cancelDeleteAccount = document.getElementById("cancel-delete-account")

  const deleteAccountConfirmation = document.getElementById(
    "delete-account-confirmation",
  ) as HTMLInputElement | null

  const confirmDeleteAccount = document.getElementById(
    "confirm-delete-account",
  ) as HTMLButtonElement | null

  const deleteAccountMessage = document.getElementById("delete-account-message")

  function openDeleteModal() {
    deleteAccountModal?.classList.remove("hidden")

    document.body.classList.add("overflow-hidden")

    deleteAccountConfirmation?.focus()
  }

  function closeDeleteModal() {
    deleteAccountModal?.classList.add("hidden")

    document.body.classList.remove("overflow-hidden")

    if (deleteAccountConfirmation) {
      deleteAccountConfirmation.checked = false
    }

    if (confirmDeleteAccount) {
      confirmDeleteAccount.disabled = true
      confirmDeleteAccount.textContent = "アカウントを完全に削除"
    }

    deleteAccountMessage?.classList.add("hidden")
  }

  openDeleteAccountModal?.addEventListener("click", () => {
    openDeleteModal()
  })

  cancelDeleteAccount?.addEventListener("click", () => {
    closeDeleteModal()
  })

  deleteAccountBackdrop?.addEventListener("click", () => {
    closeDeleteModal()
  })

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      if (!deleteAccountModal?.classList.contains("hidden")) {
        closeDeleteModal()
      }
    }
  })

  deleteAccountConfirmation?.addEventListener("change", () => {
    if (confirmDeleteAccount) {
      confirmDeleteAccount.disabled = !deleteAccountConfirmation.checked
    }
  })

  confirmDeleteAccount?.addEventListener("click", async () => {
    if (!deleteAccountConfirmation?.checked) {
      return
    }

    confirmDeleteAccount.disabled = true
    confirmDeleteAccount.textContent = "アカウントを削除しています..."

    deleteAccountMessage?.classList.add("hidden")

    try {
      const response = await fetch("/api/auth/delete", {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json",
        },
      })

      const data = await response.json().catch(() => null)

      if (!response.ok) {
        throw new Error(data?.error ?? "アカウントの削除に失敗しました。")
      }

      /*
       * The backend should invalidate the current session before
       * returning successfully.
       */

      window.location.href = "/login?deleted=true"
    } catch (error) {
      if (deleteAccountMessage) {
        deleteAccountMessage.textContent =
          error instanceof Error
            ? error.message
            : "アカウントの削除に失敗しました。"

        deleteAccountMessage.classList.remove("hidden")
      }

      confirmDeleteAccount.disabled = false
      confirmDeleteAccount.textContent = "アカウントを完全に削除"
    }
  })
</script>
