---
const { toeicGoal, eikenGoal } = Astro.props
---

<section class="mt-6 rounded-2xl border bg-white p-6 sm:p-8">
  <div
    class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
  >
    <div>
      <h2 class="text-xl font-bold text-gray-900">試験目標</h2>

      <p class="mt-1 text-sm text-gray-500">
        目標とするスコアや級を設定できます。
      </p>
    </div>

    <button
      id="edit-exam-targets-button"
      type="button"
      class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
    >
      編集
    </button>
  </div>

  <!-- DISPLAY -->

  <div id="exam-targets-display" class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="rounded-xl border p-5">
      <div class="flex items-center justify-between">
        <p class="font-semibold text-gray-900">TOEIC</p>

        {
          toeicGoal?.toeicTargetScore && (
            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">
              目標
            </span>
          )
        }
      </div>

      <p class="mt-4 text-3xl font-bold text-gray-900">
        {toeicGoal?.toeicTargetScore ?? "—"}
      </p>

      <p class="mt-1 text-sm text-gray-500">目標スコア</p>
    </div>

    <div class="rounded-xl border p-5">
      <div class="flex items-center justify-between">
        <p class="font-semibold text-gray-900">英検</p>

        {
          eikenGoal?.eikenTargetGrade && (
            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">
              目標
            </span>
          )
        }
      </div>

      <p class="mt-4 text-3xl font-bold text-gray-900">
        {
          eikenGoal?.eikenTargetGrade
            ? eikenGoal.eikenTargetGrade.replace("_", " ")
            : "—"
        }
      </p>

      <p class="mt-1 text-sm text-gray-500">目標級</p>
    </div>
  </div>

  <!-- EDITOR -->

  <div id="exam-targets-editor" class="mt-6 hidden space-y-6">
    <!-- TOEIC -->

    <div>
      <label
        for="toeic-target-score"
        class="block text-sm font-semibold text-gray-900"
      >
        TOEIC目標スコア
      </label>

      <p class="mt-1 text-xs text-gray-500">
        10～990の範囲で目標スコアを設定してください。
      </p>

      <input
        id="toeic-target-score"
        type="number"
        min="10"
        max="990"
        step="5"
        value={toeicGoal?.toeicTargetScore ?? ""}
        placeholder="例：800"
        class="mt-3 w-full rounded-lg border-gray-300 px-3 py-2 text-sm sm:max-w-md"
      />
    </div>

    <!-- EIKEN -->

    <div>
      <label
        for="eiken-target-grade"
        class="block text-sm font-semibold text-gray-900"
      >
        英検目標級
      </label>

      <select
        id="eiken-target-grade"
        class="mt-3 w-full rounded-lg border-gray-300 bg-white px-3 py-2 text-sm sm:max-w-md"
      >
        <option value="">目標を設定しない</option>
        <option
          value="grade_5"
          selected={eikenGoal?.eikenTargetGrade === "grade_5"}
        >
          5級
        </option>
        <option
          value="grade_4"
          selected={eikenGoal?.eikenTargetGrade === "grade_4"}
        >
          4級
        </option>
        <option
          value="grade_3"
          selected={eikenGoal?.eikenTargetGrade === "grade_3"}
        >
          3級
        </option>
        <option
          value="pre_2"
          selected={eikenGoal?.eikenTargetGrade === "pre_2"}
        >
          準2級
        </option>
        <option
          value="pre_2_plus"
          selected={eikenGoal?.eikenTargetGrade === "pre_2_plus"}
        >
          準2級プラス
        </option>
        <option
          value="grade_2"
          selected={eikenGoal?.eikenTargetGrade === "grade_2"}
        >
          2級
        </option>
        <option
          value="pre_1"
          selected={eikenGoal?.eikenTargetGrade === "pre_1"}
        >
          準1級
        </option>
        <option
          value="grade_1"
          selected={eikenGoal?.eikenTargetGrade === "grade_1"}
        >
          1級
        </option>
      </select>
    </div>

    <div class="flex justify-end gap-3 border-t pt-5">
      <button
        id="cancel-exam-targets-button"
        type="button"
        class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50"
      >
        キャンセル
      </button>

      <button
        id="save-exam-targets-button"
        type="button"
        class="rounded-lg bg-gray-900 px-5 py-2 text-sm font-semibold text-white hover:bg-gray-800"
      >
        変更を保存
      </button>
    </div>

    <div id="exam-targets-message" class="hidden rounded-lg px-4 py-3 text-sm">
    </div>
  </div>
</section>
<script>
  /*
   * ==========================================================================
   * 試験目標
   * ==========================================================================
   */

  const editExamTargetsButton = document.getElementById(
    "edit-exam-targets-button",
  )

  const cancelExamTargetsButton = document.getElementById(
    "cancel-exam-targets-button",
  )

  const saveExamTargetsButton = document.getElementById(
    "save-exam-targets-button",
  )

  const examTargetsDisplay = document.getElementById("exam-targets-display")

  const examTargetsEditor = document.getElementById("exam-targets-editor")

  const examTargetsMessage = document.getElementById("exam-targets-message")

  editExamTargetsButton?.addEventListener("click", () => {
    examTargetsDisplay?.classList.add("hidden")

    examTargetsEditor?.classList.remove("hidden")

    editExamTargetsButton.classList.add("hidden")
  })

  cancelExamTargetsButton?.addEventListener("click", () => {
    window.location.reload()
  })

  saveExamTargetsButton?.addEventListener("click", async () => {
    const toeicTargetScore = (
      document.getElementById("toeic-target-score") as HTMLInputElement
    )?.value.trim()

    const eikenTargetGrade = (
      document.getElementById("eiken-target-grade") as HTMLSelectElement
    )?.value

    if (
      toeicTargetScore &&
      (Number(toeicTargetScore) < 10 ||
        Number(toeicTargetScore) > 990 ||
        !Number.isInteger(Number(toeicTargetScore)))
    ) {
      if (examTargetsMessage) {
        examTargetsMessage.textContent =
          "TOEICの目標スコアは10～990の範囲で設定してください。"

        examTargetsMessage.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        examTargetsMessage.classList.remove("hidden")
      }

      return
    }

    if (saveExamTargetsButton) {
      saveExamTargetsButton.setAttribute("disabled", "true")

      saveExamTargetsButton.textContent = "保存中..."
    }

    const examGoals: {
      exam: string

      toeicTargetScore?: string

      eikenTargetGrade?: string
    }[] = []

    if (toeicTargetScore) {
      examGoals.push({
        exam: "toeic",

        toeicTargetScore,
      })
    }

    if (eikenTargetGrade) {
      examGoals.push({
        exam: "eiken",

        eikenTargetGrade,
      })
    }

    try {
      const response = await fetch("/api/settings/exam-targets", {
        method: "PATCH",

        headers: {
          "Content-Type": "application/json",
        },

        body: JSON.stringify({
          examGoals,
        }),
      })

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error ?? "試験目標の保存に失敗しました")
      }

      window.location.reload()
    } catch (error) {
      if (examTargetsMessage) {
        examTargetsMessage.textContent =
          error instanceof Error
            ? error.message
            : "試験目標の保存に失敗しました。"

        examTargetsMessage.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        examTargetsMessage.classList.remove("hidden")
      }

      saveExamTargetsButton?.removeAttribute("disabled")

      if (saveExamTargetsButton) {
        saveExamTargetsButton.textContent = "変更を保存"
      }
    }
  })

  const editButton = document.getElementById("edit-exam-targets-button")

  const cancelButton = document.getElementById("cancel-exam-targets-button")

  const saveButton = document.getElementById("save-exam-targets-button")

  const display = document.getElementById("exam-targets-display")

  const editor = document.getElementById("exam-targets-editor")

  const message = document.getElementById("exam-targets-message")

  editButton?.addEventListener("click", () => {
    display?.classList.add("hidden")
    editor?.classList.remove("hidden")
    editButton.classList.add("hidden")
  })

  cancelButton?.addEventListener("click", () => {
    window.location.reload()
  })

  saveButton?.addEventListener("click", async () => {
    const toeicTargetScore = (
      document.getElementById("toeic-target-score") as HTMLInputElement
    )?.value.trim()

    const eikenTargetGrade = (
      document.getElementById("eiken-target-grade") as HTMLSelectElement
    )?.value

    if (
      toeicTargetScore &&
      (Number(toeicTargetScore) < 10 ||
        Number(toeicTargetScore) > 990 ||
        !Number.isInteger(Number(toeicTargetScore)))
    ) {
      if (message) {
        message.textContent =
          "TOEICの目標スコアは10～990の範囲で設定してください。"

        message.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        message.classList.remove("hidden")
      }

      return
    }

    saveButton.setAttribute("disabled", "true")
    saveButton.textContent = "保存中..."

    const examGoals: {
      exam: string
      toeicTargetScore?: string
      eikenTargetGrade?: string
    }[] = []

    if (toeicTargetScore) {
      examGoals.push({
        exam: "toeic",
        toeicTargetScore,
      })
    }

    if (eikenTargetGrade) {
      examGoals.push({
        exam: "eiken",
        eikenTargetGrade,
      })
    }

    try {
      const response = await fetch("/api/settings/exam-targets", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          examGoals,
        }),
      })

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error ?? "試験目標の保存に失敗しました")
      }

      window.location.reload()
    } catch (error) {
      if (message) {
        message.textContent =
          error instanceof Error
            ? error.message
            : "試験目標の保存に失敗しました。"

        message.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        message.classList.remove("hidden")
      }

      saveButton.removeAttribute("disabled")
      saveButton.textContent = "変更を保存"
    }
  })
</script>
