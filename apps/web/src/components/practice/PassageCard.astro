---
interface Props {
  part: string
}

const { part } = Astro.props
---

<section
  id="passage-section"
  class="mb-6 overflow-hidden rounded-2xl border bg-white"
>
  <div class="border-b bg-gray-50 px-6 py-4 sm:px-8">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
          Reading Passage
        </p>

        <h2 id="passage-title" class="mt-1 text-lg font-bold text-gray-900">
        </h2>
      </div>

      <span
        class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-gray-500 ring-1 ring-gray-200"
      >
        パート {part}
      </span>
    </div>
  </div>

  <div
    id="passage-text"
    class="whitespace-pre-line px-6 py-7 text-base leading-8 text-gray-800 sm:px-8 sm:text-lg"
  >
  </div>
</section>
