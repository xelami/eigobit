---
interface Props {
  user?: {
    id: string
    email: string
    name: string | null
  }
}

const { user } = Astro.props

const displayName = user?.name?.trim() || user?.email?.split("@")[0] || ""

const initials = displayName
  ? displayName
      .split(/\s+/)
      .map((part) => part[0])
      .join("")
      .slice(0, 2)
      .toUpperCase()
  : ""
---

<nav
  class="sticky top-0 z-50 border-b border-(--border) bg-white/95 backdrop-blur"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <div class="flex items-center gap-8">
      <a
        href={user ? "/dashboard" : "/"}
        class="text-lg font-bold tracking-tight text-[var(--foreground)] transition hover:opacity-80"
      >
        英語ビット
      </a>
      {
        user && (
          <div class="hidden items-center gap-1 sm:flex">
            <a
              href="/dashboard"
              class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 hover:text-gray-900"
            >
              ホーム
            </a>
            <a
              href="/vocabulary"
              class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 hover:text-gray-900"
            >
              マイ単語
            </a>
            <a
              href="/practice"
              class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 hover:text-gray-900"
            >
              練習
            </a>
            <a
              href="/history"
              class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 hover:text-gray-900"
            >
              学習履歴
            </a>
          </div>
        )
      }
    </div>

    <div class="flex items-center gap-3">
      {
        user ? (
          <>
            <div class="hidden text-right sm:block">
              <p class="text-sm font-semibold text-gray-900">{displayName}</p>

              <p class="mt-0.5 text-xs text-gray-500">{user.email}</p>
            </div>

            <div
              class="flex h-9 w-9 items-center justify-center rounded-full bg-(--primary) text-xs font-bold text-white ring-4 ring-[var(--primary)]/10"
              aria-label={`${displayName}としてログイン中`}
            >
              {initials}
            </div>

            <div class="ml-1 flex items-center gap-1 border-l border-(--border) pl-3">
              <a
                href="/settings"
                class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 hover:text-gray-900"
              >
                設定
              </a>

              <a
                href="/logout"
                class="rounded-lg px-3 py-2 text-sm font-medium text-gray-500 transition hover:bg-gray-100 hover:text-gray-900"
              >
                ログアウト
              </a>
            </div>
          </>
        ) : (
          <div class="flex items-center gap-2">
            <a
              href="/login"
              class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 hover:text-gray-900"
            >
              ログイン
            </a>

            <a
              href="/register"
              class="rounded-lg bg-(--primary) px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:opacity-90 active:scale-[0.98]"
            >
              アカウント作成
            </a>
          </div>
        )
      }
    </div>
  </div>
</nav>
