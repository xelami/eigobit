---
import AppLayout from "../layouts/AppLayout.astro"

const API_URL = import.meta.env.PUBLIC_API_URL

const token = Astro.url.searchParams.get("token")

let error: string | null = null
let success = false

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData()

  const password = formData.get("password")
  const confirmPassword = formData.get("confirmPassword")

  if (!token) {
    error = "このパスワードリセットリンクは無効です。"
  } else if (
    typeof password !== "string" ||
    typeof confirmPassword !== "string"
  ) {
    error = "有効なパスワードを入力してください。"
  } else if (password !== confirmPassword) {
    error = "パスワードが一致しません。"
  } else if (password.length < 8) {
    error = "パスワードは8文字以上で入力してください。"
  } else {
    try {
      const response = await fetch(`${API_URL}/api/v1/auth/reset-password`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          token,
          password,
        }),
      })

      const data = await response.json()

      if (!response.ok) {
        error = data.error ?? "パスワードをリセットできませんでした。"
      } else {
        success = true
      }
    } catch {
      error = "サーバーに接続できませんでした。"
    }
  }
}
---

<AppLayout title="パスワードのリセット | 英語ビット">
  <main
    class="flex min-h-[calc(100vh-4rem)] items-center justify-center px-6 py-12"
  >
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold tracking-tight">パスワードをリセット</h1>

        <p class="mt-2 text-sm text-(--muted)">
          新しいパスワードを設定してください。
        </p>
      </div>

      <div class="rounded-xl border border-(--border) bg-white p-8 shadow-sm">
        {
          success ? (
            <div class="text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-green-100 text-green-700">
                ✓
              </div>

              <h2 class="mt-4 text-lg font-semibold">
                パスワードを変更しました
              </h2>

              <p class="mt-2 text-sm leading-6 text-(--muted)">
                パスワードの変更が完了しました。新しいパスワードでログインできます。
              </p>

              <a
                href="/login"
                class="mt-6 inline-block rounded-lg bg-(--primary) px-5 py-3 text-sm font-semibold text-white"
              >
                ログイン
              </a>
            </div>
          ) : !token ? (
            <div class="text-center">
              <p class="text-sm text-red-600">
                このパスワードリセットリンクは無効か、不完全です。
              </p>

              <a
                href="/forgot-password"
                class="mt-6 inline-block text-sm font-semibold text-(--primary) hover:underline"
              >
                新しいリセットリンクをリクエスト
              </a>
            </div>
          ) : (
            <>
              {error && (
                <div
                  role="alert"
                  class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
                >
                  {error}
                </div>
              )}

              <form method="POST" class="space-y-5">
                <div>
                  <label for="password" class="mb-2 block text-sm font-medium">
                    新しいパスワード
                  </label>

                  <input
                    id="password"
                    name="password"
                    type="password"
                    autocomplete="new-password"
                    required
                    minlength="8"
                    maxlength="128"
                    placeholder="8文字以上"
                    class="w-full rounded-lg border border-(--border) bg-white px-3.5 py-2.5 text-sm text-[var(--foreground)] outline-none transition placeholder:text-(--muted) focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/20"
                  />
                </div>

                <div>
                  <label
                    for="confirmPassword"
                    class="mb-2 block text-sm font-medium"
                  >
                    パスワード（確認）
                  </label>

                  <input
                    id="confirmPassword"
                    name="confirmPassword"
                    type="password"
                    autocomplete="new-password"
                    required
                    minlength="8"
                    maxlength="128"
                    placeholder="もう一度入力してください"
                    class="w-full rounded-lg border border-(--border) bg-white px-3.5 py-2.5 text-sm text-[var(--foreground)] outline-none transition placeholder:text-(--muted) focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/20"
                  />
                </div>

                <button
                  type="submit"
                  class="w-full rounded-lg bg-(--primary) px-4 py-3 text-sm font-semibold text-white transition hover:opacity-90"
                >
                  パスワードをリセット
                </button>
              </form>
            </>
          )
        }
      </div>
    </div>
  </main>
</AppLayout>
