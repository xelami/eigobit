---
import type { APIContext } from "astro"
import { apiFetch } from "../lib/api"
import { clearSession } from "../lib/session"

const context = Astro

try {
  await apiFetch("/api/v1/auth/logout", context, {
    method: "POST",
  })
} catch {
  // Even if the API session is already gone,
  // we still want to remove the local cookie.
}

clearSession(context)

return Astro.redirect("/login")
---