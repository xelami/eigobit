---
import AppLayout from "../layouts/AppLayout.astro"
import { requireAuth } from "../lib/require-auth"

const user = await requireAuth(Astro)

if (user instanceof Response) {
  return user
}

const type = Astro.url.searchParams.get("type") ?? "practice"

const activities = {
  vocabulary: {
    title: "Vocabulary",
    description: "Build your English vocabulary.",
  },
  listening: {
    title: "Listening",
    description: "Train your ability to understand spoken English.",
  },
  reading: {
    title: "Reading",
    description: "Practice understanding written English.",
  },
  practice: {
    title: "Practice",
    description: "A quick English practice session.",
  },
}

const activity =
  activities[type as keyof typeof activities] ?? activities.practice
---

<AppLayout title={activity.title} user={user}>
  <main class="mx-auto max-w-4xl px-6 py-10">
    <a
      href="/dashboard"
      class="text-sm font-medium text-gray-500 hover:text-gray-900"
    >
      ← Back to dashboard
    </a>
    <div class="mt-8">
      <p class="text-sm font-medium text-gray-500">Study session</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight">
        {activity.title}
      </h1>
      <p class="mt-2 text-gray-600">
        {activity.description}
      </p>
    </div>
    <div class="mx-auto max-w-7xl px-6 py-10">
      <h1 class="text-3xl font-bold">Study</h1>
    </div>
    <section class="mt-8 rounded-2xl border bg-white p-6 sm:p-8">
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-gray-500"> Question 1 </span>
        <span class="text-sm text-gray-500"> 0 / 5 </span>
      </div>
      <div class="mt-6">
        <h2 class="text-xl font-semibold">
          What does <span class="font-bold">"reliable"</span> mean?
        </h2>
        <div class="mt-6 grid gap-3">
          <button
            type="button"
            class="w-full rounded-xl border p-4 text-left transition hover:border-gray-400 hover:bg-gray-50"
          >
            Something you can trust or depend on
          </button>
          <button
            type="button"
            class="w-full rounded-xl border p-4 text-left transition hover:border-gray-400 hover:bg-gray-50"
          >
            Something that is very expensive
          </button>
          <button
            type="button"
            class="w-full rounded-xl border p-4 text-left transition hover:border-gray-400 hover:bg-gray-50"
          >
            Something that happens unexpectedly
          </button>
          <button
            type="button"
            class="w-full rounded-xl border p-4 text-left transition hover:border-gray-400 hover:bg-gray-50"
          >
            Something that is difficult to understand
          </button>
        </div>
      </div>
    </section>
  </main>
</AppLayout>
