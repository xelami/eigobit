---
import AppLayout from "../../layouts/AppLayout.astro"
import { requireAuth } from "../../lib/require-auth"
import { apiFetch } from "../../lib/api"

const user = await requireAuth(Astro)

if (user instanceof Response) {
  return user
}

const id = Astro.params.id

if (!id) {
  return Astro.redirect("/vocabulary")
}

type VocabularyItem = {
  id: string
  word: string
  meaning: string | null
  exampleSentence: string | null
  notes: string | null
  tags: string | null
  createdAt: string
  updatedAt: string
}

let item: VocabularyItem | null = null

try {
  const data = await apiFetch<{ word: VocabularyItem }>(
    `/api/v1/vocabulary/${id}`,
    Astro,
  )

  item = data.word
} catch {
  return Astro.redirect("/vocabulary")
}

if (!item) {
  return Astro.redirect("/vocabulary")
}

const tags = item.tags
  ? item.tags
      .split(",")
      .map((tag) => tag.trim())
      .filter(Boolean)
  : []
---

<AppLayout title={item.word} user={user}>
  <main class="mx-auto max-w-3xl px-6 py-10">
    <!-- Back -->

    <a
      href="/vocabulary"
      class="text-sm font-medium text-gray-500 hover:text-gray-900"
    >
      ← マイ単語に戻る
    </a>

    <!-- Header -->

    <div
      class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
    >
      <div>
        <p class="text-sm font-medium text-gray-500">マイ単語</p>

        <h1 class="mt-1 text-4xl font-bold tracking-tight">
          {item.word}
        </h1>

        {
          item.meaning && (
            <p class="mt-3 text-xl text-gray-600">{item.meaning}</p>
          )
        }
      </div>

      <div class="flex gap-2">
        <a
          href={`/vocabulary/${item.id}/edit`}
          class="rounded-lg border px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
        >
          編集
        </a>

        <form method="POST" action={`/vocabulary/${item.id}/delete`}>
          <button
            type="submit"
            class="rounded-lg border border-red-200 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50"
          >
            削除
          </button>
        </form>
      </div>
    </div>

    <!-- Content -->

    <div class="mt-8 space-y-6">
      {
        item.exampleSentence && (
          <section class="rounded-2xl border bg-white p-6">
            <p class="text-sm font-medium text-gray-500">例文</p>

            <p class="mt-3 text-lg leading-8 text-gray-900">
              {item.exampleSentence}
            </p>
          </section>
        )
      }

      {
        tags.length > 0 && (
          <section class="rounded-2xl border bg-white p-6">
            <p class="text-sm font-medium text-gray-500">タグ</p>

            <div class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700">
                  {tag}
                </span>
              ))}
            </div>
          </section>
        )
      }

      {
        item.notes && (
          <section class="rounded-2xl border bg-white p-6">
            <p class="text-sm font-medium text-gray-500">メモ</p>

            <p class="mt-3 whitespace-pre-wrap leading-7 text-gray-700">
              {item.notes}
            </p>
          </section>
        )
      }

      <section class="rounded-2xl border bg-gray-50 p-6">
        <div class="grid gap-4 text-sm sm:grid-cols-2">
          <div>
            <p class="text-gray-500">追加日</p>

            <p class="mt-1 font-medium text-gray-900">
              {new Date(item.createdAt).toLocaleDateString("ja-JP")}
            </p>
          </div>

          <div>
            <p class="text-gray-500">最終更新</p>

            <p class="mt-1 font-medium text-gray-900">
              {new Date(item.updatedAt).toLocaleDateString("ja-JP")}
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>
</AppLayout>
