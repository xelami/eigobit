---
import AppLayout from "../../../layouts/AppLayout.astro"
import { requireAuth } from "../../../lib/require-auth"
import { apiFetch } from "../../../lib/api"

const user = await requireAuth(Astro)

if (user instanceof Response) {
  return user
}

const id = Astro.params.id

if (!id) {
  return Astro.redirect("/vocabulary")
}

type VocabularyItem = {
  id: string
  word: string
  meaning: string | null
  exampleSentence: string | null
  notes: string | null
  tags: string | null
}

let item: VocabularyItem | null = null
let error = ""

try {
  const data = await apiFetch<{ word: VocabularyItem }>(
    `/api/v1/vocabulary/${id}`,
    Astro,
  )

  item = data.word
} catch {
  return Astro.redirect("/vocabulary")
}

if (!item) {
  return Astro.redirect("/vocabulary")
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()

  const word = String(form.get("word") || "").trim()
  const meaning = String(form.get("meaning") || "").trim()
  const exampleSentence = String(form.get("exampleSentence") || "").trim()
  const notes = String(form.get("notes") || "").trim()
  const tags = String(form.get("tags") || "").trim()

  if (!word) {
    error = "単語を入力してください。"
  } else {
    try {
      await apiFetch(`/api/v1/vocabulary/${id}`, Astro, {
        method: "PUT",
        body: JSON.stringify({
          word,
          meaning: meaning || null,
          exampleSentence: exampleSentence || null,
          notes: notes || null,
          tags: tags || null,
        }),
      })

      return Astro.redirect(`/vocabulary/${id}`)
    } catch {
      error = "単語を更新できませんでした。もう一度お試しください。"
    }
  }
}
---

<AppLayout title="単語を編集" user={user}>
  <main class="mx-auto max-w-2xl px-6 py-10">
    <div class="mb-8">
      <a
        href={`/vocabulary/${id}`}
        class="text-sm font-medium text-gray-500 hover:text-gray-900"
      >
        ← 単語に戻る
      </a>

      <h1 class="mt-5 text-3xl font-bold tracking-tight">単語を編集</h1>

      <p class="mt-2 text-sm text-gray-600">
        単語の意味や例文、メモなどを変更できます。
      </p>
    </div>

    {
      error && (
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          {error}
        </div>
      )
    }

    <form method="POST" class="space-y-6 rounded-2xl border bg-white p-6">
      <div>
        <label for="word" class="block text-sm font-medium text-gray-900">
          英単語
          <span class="text-red-500">*</span>
        </label>

        <input
          id="word"
          name="word"
          type="text"
          required
          value={item.word}
          class="mt-2 w-full rounded-lg border px-4 py-3 text-base outline-none transition focus:border-gray-400 focus:ring-2 focus:ring-gray-200"
        />
      </div>

      <div>
        <label for="meaning" class="block text-sm font-medium text-gray-900">
          意味
        </label>

        <input
          id="meaning"
          name="meaning"
          type="text"
          value={item.meaning ?? ""}
          placeholder="例: 機会、チャンス"
          class="mt-2 w-full rounded-lg border px-4 py-3 text-base outline-none transition focus:border-gray-400 focus:ring-2 focus:ring-gray-200"
        />
      </div>

      <div>
        <label
          for="exampleSentence"
          class="block text-sm font-medium text-gray-900"
        >
          例文
        </label>

        <textarea
          id="exampleSentence"
          name="exampleSentence"
          rows="3"
          placeholder="例: This job offers a great opportunity to learn."
          class="mt-2 w-full resize-y rounded-lg border px-4 py-3 text-base outline-none transition focus:border-gray-400 focus:ring-2 focus:ring-gray-200"
          >{item.exampleSentence ?? ""}</textarea
        >
      </div>

      <div>
        <label for="tags" class="block text-sm font-medium text-gray-900">
          タグ
        </label>

        <input
          id="tags"
          name="tags"
          type="text"
          value={item.tags ?? ""}
          placeholder="例: TOEIC, 仕事, 重要"
          class="mt-2 w-full rounded-lg border px-4 py-3 text-base outline-none transition focus:border-gray-400 focus:ring-2 focus:ring-gray-200"
        />

        <p class="mt-2 text-xs text-gray-500">
          複数のタグはカンマ（,）で区切ってください。
        </p>
      </div>

      <div>
        <label for="notes" class="block text-sm font-medium text-gray-900">
          メモ
        </label>

        <textarea
          id="notes"
          name="notes"
          rows="3"
          placeholder="例: opportunity と chance の違いを覚える"
          class="mt-2 w-full resize-y rounded-lg border px-4 py-3 text-base outline-none transition focus:border-gray-400 focus:ring-2 focus:ring-gray-200"
          >{item.notes ?? ""}</textarea
        >
      </div>

      <div
        class="flex flex-col-reverse gap-3 border-t pt-6 sm:flex-row sm:justify-end"
      >
        <a
          href={`/vocabulary/${id}`}
          class="inline-flex items-center justify-center rounded-lg border px-5 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50"
        >
          キャンセル
        </a>

        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white transition hover:bg-gray-700"
        >
          変更を保存
        </button>
      </div>
    </form>
  </main>
</AppLayout>
