---
import AppLayout from "../../layouts/AppLayout.astro"
import { requireAuth } from "../../lib/require-auth"
import { getPracticePassages, getPracticeSession } from "../../lib/practice/api"
import type { PracticeQuestion, PracticePassage, PracticeSession } from "../../lib/practice/types"
import PracticeHeader from "../../components/practice/PracticeHeader.astro"
import ProgressBar from "../../components/practice/ProgressBar.astro"
import PassageCard from "../../components/practice/PassageCard.astro"
import QuestionCard from "../../components/practice/QuestionCard.astro"

const user = await requireAuth(Astro)

if (user instanceof Response) {
  return user
}

const { id } = Astro.params

if (!id) {
  return Astro.redirect("/dashboard")
}

let session: PracticeSession | null = null
let questions: PracticeQuestion[] = []
let passages: PracticePassage[] = []

try {

  const data = await getPracticeSession(id, Astro)
  session = data.session
  questions = data.questions

  if (session.part === "6" || session.part === "7") {
    const passageData = await getPracticePassages(
      session.exam,
      session.part,
      Astro,
    )
    passages = passageData.passages
  }

} catch {
  return Astro.redirect("/dashboard")
}

if (!session || questions.length === 0) {
  return Astro.redirect("/dashboard")
}

const isPart7 = session.part === "7"
---

<AppLayout title={`TOEIC Part ${session.part}`} user={user}>
  <main class="mx-auto max-w-5xl px-6 py-10">

  <PracticeHeader
    exam={session.exam}
    part={session.part}
    isPart7={isPart7}
    questionCount={questions.length}
  />

  <ProgressBar />

    {
      isPart7 ? (
        <div id="part7-container" class="space-y-8">
          <!-- Rendered by JavaScript -->
        </div>
      ) : (
        <>
        {
          session.part === "6" && (
            <PassageCard part={session.part} />
          )
        }
          <QuestionCard question={questions[0]} />
        </>
      )
    }
  </main>
  <script type="application/json" id="practice-data" set:html={JSON.stringify({
    questions,
    passages,
    sessionId: id,
    isPart7,
  }).replace(/</g, "\\u003c")}
  />

  <script src="../../scripts/practice.ts"></script>
</AppLayout>