---
import AppLayout from "../../layouts/AppLayout.astro"
import { requireAuth } from "../../lib/require-auth"
import { apiFetch } from "../../lib/api"

const user = await requireAuth(Astro)

if (user instanceof Response) {
  return user
}

let error = ""

let selectedPart = "5"

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData()

    const requestedPart = formData.get("part")

    selectedPart =
      requestedPart === "6" || requestedPart === "7" ? requestedPart : "5"

    const limit = selectedPart === "5" ? 10 : selectedPart === "6" ? 4 : 10

    const result = await apiFetch<{
      sessionId: string
      exam: string
      part: string
      totalQuestions: number
    }>("/api/v1/practice/sessions", Astro, {
      method: "POST",
      body: JSON.stringify({
        exam: "toeic",
        part: selectedPart,
        limit,
      }),
    })

    return Astro.redirect(`/practice/${result.sessionId}`)
  } catch (err) {
    console.error("PRACTICE SESSION ERROR:", err)

    error =
      err instanceof Error ? err.message : "Failed to start practice session"
  }
}
---

<AppLayout title="TOEIC 練習 | 英語ビット" user={user}>
  <main class="mx-auto max-w-4xl px-6 py-12">
    <a
      href="/dashboard"
      class="text-sm font-medium text-gray-500 transition hover:text-gray-900"
    >
      ← ホームに戻る
    </a>

    <div class="mt-8">
      <p class="text-sm font-medium text-gray-500">TOEIC</p>

      <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
        TOEIC 練習
      </h1>

      <p class="mt-3 text-gray-600">練習したいPartを選択してください。</p>
    </div>

    {
      error && (
        <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4">
          <p class="text-sm text-red-700">{error}</p>
        </div>
      )
    }

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <form method="POST">
        <input type="hidden" name="part" value="5" />

        <button
          type="submit"
          class="group w-full rounded-2xl border border-gray-200 bg-white p-6 text-left transition hover:-translate-y-0.5 hover:border-gray-400 hover:shadow-md"
        >
          <div class="flex items-start justify-between">
            <div>
              <span
                class="text-xs font-semibold uppercase tracking-wide text-gray-400"
              >
                TOEIC
              </span>

              <h2 class="mt-2 text-2xl font-bold text-gray-900">Part 5</h2>
            </div>

            <span
              class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600"
            >
              10問
            </span>
          </div>

          <p class="mt-4 font-medium text-gray-900">短文穴埋め問題</p>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            文の空欄に入る最も適切な単語やフレーズを選びます。
          </p>

          <div class="mt-6 flex items-center justify-between">
            <span class="text-sm text-gray-500">4択</span>

            <span
              class="font-semibold text-gray-900 transition group-hover:translate-x-1"
            >
              練習を始める →
            </span>
          </div>
        </button>
      </form>

      <form method="POST">
        <input type="hidden" name="part" value="6" />

        <button
          type="submit"
          class="group w-full rounded-2xl border border-gray-200 bg-white p-6 text-left transition hover:-translate-y-0.5 hover:border-gray-400 hover:shadow-md"
        >
          <div class="flex items-start justify-between">
            <div>
              <span
                class="text-xs font-semibold uppercase tracking-wide text-gray-400"
              >
                TOEIC
              </span>

              <h2 class="mt-2 text-2xl font-bold text-gray-900">Part 6</h2>
            </div>

            <span
              class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600"
            >
              4問
            </span>
          </div>

          <p class="mt-4 font-medium text-gray-900">長文穴埋め問題</p>

          <p class="mt-2 text-sm leading-6 text-gray-500">
            長文を読み、空欄に入る単語や文章を選びます。
          </p>

          <div class="mt-6 flex items-center justify-between">
            <span class="text-sm text-gray-500">4択</span>

            <span
              class="font-semibold text-gray-900 transition group-hover:translate-x-1"
            >
              練習を始める →
            </span>
          </div>
        </button>
      </form>
    </div>

    <form method="POST" class="mt-6">
      <input type="hidden" name="part" value="7" />

      <button
        type="submit"
        class="group w-full rounded-2xl border border-gray-200 bg-white p-6 text-left transition hover:-translate-y-0.5 hover:border-gray-400 hover:shadow-md"
      >
        <div class="flex items-start justify-between">
          <div>
            <span
              class="text-xs font-semibold uppercase tracking-wide text-gray-400"
            >
              TOEIC
            </span>

            <h2 class="mt-2 text-2xl font-bold text-gray-900">Part 7</h2>
          </div>

          <span
            class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600"
          >
            Reading
          </span>
        </div>

        <p class="mt-4 font-medium text-gray-900">読解問題</p>

        <p class="mt-2 text-sm leading-6 text-gray-500">
          メール、案内、広告、記事などの文章を読み、内容についての質問に答えます。
        </p>

        <div class="mt-6 flex items-center justify-between">
          <span class="text-sm text-gray-500">4択</span>

          <span
            class="font-semibold text-gray-900 transition group-hover:translate-x-1"
          >
            練習を始める →
          </span>
        </div>
      </button>
    </form>
  </main>
</AppLayout>
