---
import AppLayout from "../layouts/AppLayout.astro"

const API_URL = import.meta.env.PUBLIC_API_URL

let error: string | null = null
let submitted = false

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData()

  const email = formData.get("email")

  if (typeof email !== "string") {
    error = "Please enter a valid email address."
  } else {
    try {
      const response = await fetch(`${API_URL}/api/v1/auth/forgot-password`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          email,
        }),
      })

      if (!response.ok) {
        error = "Something went wrong. Please try again."
      } else {
        submitted = true
      }
    } catch {
      error = "Unable to connect to the server."
    }
  }
}
---

<AppLayout title="パスワードを忘れた場合 | 英語ビット">
  <main
    class="flex min-h-[calc(100vh-4rem)] items-center justify-center px-6 py-12"
  >
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <p class="mb-3 text-sm font-semibold text-(--primary)">
          アカウント復旧
        </p>
        <h1 class="text-3xl font-bold tracking-tight">
          パスワードをお忘れですか？
        </h1>

        <p class="mt-2 text-sm leading-6 text-(--muted)">
          ご安心ください。登録しているメールアドレスを入力すると、
          パスワードを再設定するためのリンクをお送りします。
        </p>
      </div>

      <div class="rounded-2xl border border-(--border) bg-white p-8 shadow-sm">
        {
          submitted ? (
            <div class="text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-green-100 text-lg font-bold text-green-700">
                ✓
              </div>

              <h2 class="mt-4 text-lg font-semibold text-(--foreground)">
                メールを確認してください
              </h2>

              <p class="mt-2 text-sm leading-6 text-(--muted)">
                入力されたメールアドレスにアカウントが登録されている場合、
                パスワード再設定用のリンクをお送りします。
              </p>

              <a
                href="/login"
                class="mt-6 inline-block text-sm font-semibold text-(--primary) hover:underline"
              >
                ログインに戻る
              </a>
            </div>
          ) : (
            <>
              {error && (
                <div
                  role="alert"
                  class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
                >
                  {error}
                </div>
              )}

              <form method="POST" class="space-y-5">
                <div>
                  <label
                    for="email"
                    class="mb-2 block text-sm font-medium text-(--foreground)"
                  >
                    メールアドレス
                  </label>

                  <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                    placeholder="you@example.com"
                    class="w-full rounded-lg border border-(--border) bg-white px-3.5 py-2.5 text-sm text-(--foreground) outline-none transition placeholder:text-(--muted) focus:border-(--primary) focus:ring-2 focus:ring-(--primary)/20"
                  />

                  <p class="mt-2 text-xs text-(--muted)">
                    パスワード再設定のためにのみ使用します。
                  </p>
                </div>

                <button
                  type="submit"
                  class="w-full rounded-lg bg-(--primary) px-4 py-3 text-sm font-semibold text-white transition hover:opacity-90 active:scale-[0.99]"
                >
                  再設定リンクを送信
                </button>
              </form>

              <div class="mt-6 border-t border-(--border) pt-6 text-center">
                <p class="text-sm text-(--muted)">
                  パスワードを思い出しましたか？
                  <a
                    href="/login"
                    class="font-semibold text-(--primary) hover:underline"
                  >
                    ログインに戻る
                  </a>
                </p>
              </div>
            </>
          )
        }
      </div>
    </div>
  </main>
</AppLayout>
