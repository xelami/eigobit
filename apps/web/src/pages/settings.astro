---
import AppLayout from "../layouts/AppLayout.astro"
import { requireAuth } from "../lib/require-auth"
import { apiFetch } from "../lib/api"
import Profile from "../components/settings/Profile.astro"
import ConnectedAccounts from "../components/settings/ConnectedAccounts.astro"
import LearningPreferences from "../components/settings/LearningPreferences.astro"
import ExamTargets from "../components/settings/ExamTargets.astro"
import Security from "../components/settings/Security.astro"
import DangerZone from "../components/settings/DangerZone.astro"

const user = await requireAuth(Astro)

if (user instanceof Response) {
  return user
}

let onboarding: {
  profile: {
    englishLevel: string
    studyTime: string
    onboardingCompleted: string | null
  } | null
  learningGoals: string[]
  interests: string[]
  examGoals: {
    exam: string
    toeicTargetScore: string | null
    eikenTargetGrade: string | null
  }[]
} | null = null

let preferences = {
  englishLevel: null as string | null,
  studyTime: null as string | null,
  learningGoals: [] as string[],
  interests: [] as string[],
  examGoals: [] as {
    exam: string
    toeicTargetScore: string | null
    eikenTargetGrade: string | null
  }[],
}

try {
  preferences = await apiFetch<{
    englishLevel: string | null
    studyTime: string | null
    learningGoals: string[]
    interests: string[]
    examGoals: {
      exam: string
      toeicTargetScore: string | null
      eikenTargetGrade: string | null
    }[]
  }>("/api/v1/settings/preferences", Astro)
} catch {
  // Keep defaults.
}

let connectedAccounts = {
  google: false,
  apple: false,
  line: false,
}

try {
  connectedAccounts = await apiFetch<{
    google: boolean
    apple: boolean
    line: boolean
  }>("/api/v1/auth/link/accounts", Astro)
} catch {
  // Continue without connected account information.
}

const googleAccount = connectedAccounts.google

try {
  onboarding = await apiFetch<{
    profile: {
      englishLevel: string
      studyTime: string
      onboardingCompleted: string | null
    } | null
    learningGoals: string[]
    interests: string[]
    examGoals: {
      exam: string
      toeicTargetScore: string | null
      eikenTargetGrade: string | null
    }[]
  }>("/api/v1/onboarding", Astro)
} catch {
  // Continue without onboarding data.
}

const profile = onboarding?.profile

const learningGoals = onboarding?.learningGoals ?? []

const examGoals = onboarding?.examGoals ?? []

const toeicGoal = examGoals.find((goal) => goal.exam === "toeic")

const eikenGoal = examGoals.find((goal) => goal.exam === "eiken")
---

<AppLayout title="設定" user={user}>
  <main class="mx-auto max-w-4xl px-6 py-10">
    <!-- HEADER -->

    <div class="mb-10">
      <a
        href="/dashboard"
        class="text-sm font-medium text-gray-500 transition hover:text-gray-900"
      >
        ← ダッシュボード
      </a>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900">設定</h1>

      <p class="mt-2 text-gray-500">
        アカウント、学習設定、練習に関する設定を管理できます。
      </p>
    </div>

    <!-- PROFILE -->

    <Profile user={user} />

    <!-- CONNECTED ACCOUNTS -->

    <ConnectedAccounts googleAccount={googleAccount} />

    <!-- LEARNING PREFERENCES -->

    <LearningPreferences preferences={preferences} />

    <!-- EXAM TARGETS -->

    <ExamTargets toeicGoal={toeicGoal} eikenGoal={eikenGoal} />

    <!-- ACCOUNT & SECURITY -->

    <Security />

    <!-- DANGER ZONE -->

    <DangerZone />

    <!-- DELETE ACCOUNT MODAL -->

    <div
      id="delete-account-modal"
      class="fixed inset-0 z-50 hidden"
      aria-labelledby="delete-account-title"
      aria-modal="true"
      role="dialog"
    >
      <!-- Backdrop -->

      <div
        id="delete-account-backdrop"
        class="absolute inset-0 bg-black/50 backdrop-blur-sm"
      >
      </div>

      <!-- Modal -->

      <div class="relative flex min-h-full items-center justify-center p-4">
        <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl sm:p-8">
          <!-- Header -->

          <div>
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-100 text-red-700"
            >
              !
            </div>

            <h2
              id="delete-account-title"
              class="mt-5 text-xl font-bold text-gray-900"
            >
              アカウントを削除しますか？
            </h2>

            <p class="mt-2 text-sm leading-6 text-gray-600">
              この操作は永久的なもので、元に戻すことはできません。
            </p>
          </div>

          <!-- Warning -->

          <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4">
            <p class="text-sm font-semibold text-red-800">
              以下の情報が完全に削除されます：
            </p>

            <ul class="mt-3 space-y-2 text-sm leading-5 text-red-700">
              <li>• アカウントおよびプロフィール情報</li>
              <li>• 学習設定および興味・関心</li>
              <li>• TOEIC・英検の目標</li>
              <li>• 練習セッションおよび結果</li>
              <li>• 保存した単語および学習データ</li>
              <li>• 連携済みGoogle / OAuthアカウント情報</li>
              <li>• 現在ログイン中のセッション</li>
            </ul>
          </div>

          <p class="mt-5 text-sm leading-6 text-gray-600">
            アカウントを削除すると、データを復元することはできません。
          </p>

          <!-- Confirmation -->

          <label
            class="mt-6 flex cursor-pointer items-start gap-3 rounded-xl border p-4 transition hover:bg-gray-50"
          >
            <input
              id="delete-account-confirmation"
              type="checkbox"
              class="mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-red-600 focus:ring-red-500"
            />

            <span class="text-sm font-medium leading-5 text-gray-700">
              アカウントと関連するすべてのデータが完全に削除され、復元できないことを理解しました。
            </span>
          </label>

          <!-- Error -->

          <div
            id="delete-account-message"
            class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
          >
          </div>

          <!-- Actions -->

          <div
            class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
          >
            <button
              id="cancel-delete-account"
              type="button"
              class="rounded-lg border px-5 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
            >
              キャンセル
            </button>

            <button
              id="confirm-delete-account"
              type="button"
              disabled
              class="rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-40"
            >
              アカウントを完全に削除
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 text-center">
      <a
        href="/dashboard"
        class="text-sm font-medium text-gray-500 transition hover:text-gray-900"
      >
        ← ダッシュボードに戻る
      </a>
    </div>
  </main>
</AppLayout>

<script>
  /*
   * ==========================================================================
   * 試験目標
   * ==========================================================================
   */

  const editExamTargetsButton = document.getElementById(
    "edit-exam-targets-button",
  )

  const cancelExamTargetsButton = document.getElementById(
    "cancel-exam-targets-button",
  )

  const saveExamTargetsButton = document.getElementById(
    "save-exam-targets-button",
  )

  const examTargetsDisplay = document.getElementById("exam-targets-display")

  const examTargetsEditor = document.getElementById("exam-targets-editor")

  const examTargetsMessage = document.getElementById("exam-targets-message")

  editExamTargetsButton?.addEventListener("click", () => {
    examTargetsDisplay?.classList.add("hidden")

    examTargetsEditor?.classList.remove("hidden")

    editExamTargetsButton.classList.add("hidden")
  })

  cancelExamTargetsButton?.addEventListener("click", () => {
    window.location.reload()
  })

  saveExamTargetsButton?.addEventListener("click", async () => {
    const toeicTargetScore = (
      document.getElementById("toeic-target-score") as HTMLInputElement
    )?.value.trim()

    const eikenTargetGrade = (
      document.getElementById("eiken-target-grade") as HTMLSelectElement
    )?.value

    if (
      toeicTargetScore &&
      (Number(toeicTargetScore) < 10 ||
        Number(toeicTargetScore) > 990 ||
        !Number.isInteger(Number(toeicTargetScore)))
    ) {
      if (examTargetsMessage) {
        examTargetsMessage.textContent =
          "TOEICの目標スコアは10～990の範囲で設定してください。"

        examTargetsMessage.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        examTargetsMessage.classList.remove("hidden")
      }

      return
    }

    if (saveExamTargetsButton) {
      saveExamTargetsButton.setAttribute("disabled", "true")

      saveExamTargetsButton.textContent = "保存中..."
    }

    const examGoals: {
      exam: string

      toeicTargetScore?: string

      eikenTargetGrade?: string
    }[] = []

    if (toeicTargetScore) {
      examGoals.push({
        exam: "toeic",

        toeicTargetScore,
      })
    }

    if (eikenTargetGrade) {
      examGoals.push({
        exam: "eiken",

        eikenTargetGrade,
      })
    }

    try {
      const response = await fetch("/api/settings/exam-targets", {
        method: "PATCH",

        headers: {
          "Content-Type": "application/json",
        },

        body: JSON.stringify({
          examGoals,
        }),
      })

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error ?? "試験目標の保存に失敗しました")
      }

      window.location.reload()
    } catch (error) {
      if (examTargetsMessage) {
        examTargetsMessage.textContent =
          error instanceof Error
            ? error.message
            : "試験目標の保存に失敗しました。"

        examTargetsMessage.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        examTargetsMessage.classList.remove("hidden")
      }

      saveExamTargetsButton?.removeAttribute("disabled")

      if (saveExamTargetsButton) {
        saveExamTargetsButton.textContent = "変更を保存"
      }
    }
  })

  const disconnectButtons = document.querySelectorAll(
    "[data-disconnect-provider]",
  )

  const message = document.getElementById("connected-accounts-message")

  disconnectButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const provider = button.getAttribute("data-disconnect-provider")

      if (!provider) {
        return
      }

      const confirmed = window.confirm(
        `${provider}アカウントとの連携を解除しますか？`,
      )

      if (!confirmed) {
        return
      }

      button.setAttribute("disabled", "true")

      try {
        const response = await fetch(`/api/v1/oauth/link/${provider}`, {
          method: "DELETE",
          credentials: "include",
        })

        const data = await response.json()

        if (!response.ok) {
          throw new Error(data.error ?? "アカウントの連携解除に失敗しました")
        }

        window.location.reload()
      } catch (error) {
        if (message) {
          message.textContent =
            error instanceof Error
              ? error.message
              : "アカウントの連携解除に失敗しました。"

          message.classList.remove("hidden")
          message.classList.add(
            "border",
            "border-red-200",
            "bg-red-50",
            "text-red-700",
          )
        }

        button.removeAttribute("disabled")
      }
    })
  })

  /*
   * ==========================================================================
   * アカウント削除
   * ==========================================================================
   */

  const openDeleteAccountModal = document.getElementById(
    "open-delete-account-modal",
  )

  const deleteAccountModal = document.getElementById("delete-account-modal")

  const deleteAccountBackdrop = document.getElementById(
    "delete-account-backdrop",
  )

  const cancelDeleteAccount = document.getElementById("cancel-delete-account")

  const deleteAccountConfirmation = document.getElementById(
    "delete-account-confirmation",
  ) as HTMLInputElement | null

  const confirmDeleteAccount = document.getElementById(
    "confirm-delete-account",
  ) as HTMLButtonElement | null

  const deleteAccountMessage = document.getElementById("delete-account-message")

  function openDeleteModal() {
    deleteAccountModal?.classList.remove("hidden")

    document.body.classList.add("overflow-hidden")

    deleteAccountConfirmation?.focus()
  }

  function closeDeleteModal() {
    deleteAccountModal?.classList.add("hidden")

    document.body.classList.remove("overflow-hidden")

    if (deleteAccountConfirmation) {
      deleteAccountConfirmation.checked = false
    }

    if (confirmDeleteAccount) {
      confirmDeleteAccount.disabled = true
      confirmDeleteAccount.textContent = "アカウントを完全に削除"
    }

    deleteAccountMessage?.classList.add("hidden")
  }

  openDeleteAccountModal?.addEventListener("click", () => {
    openDeleteModal()
  })

  cancelDeleteAccount?.addEventListener("click", () => {
    closeDeleteModal()
  })

  deleteAccountBackdrop?.addEventListener("click", () => {
    closeDeleteModal()
  })

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      if (!deleteAccountModal?.classList.contains("hidden")) {
        closeDeleteModal()
      }
    }
  })

  deleteAccountConfirmation?.addEventListener("change", () => {
    if (confirmDeleteAccount) {
      confirmDeleteAccount.disabled = !deleteAccountConfirmation.checked
    }
  })

  confirmDeleteAccount?.addEventListener("click", async () => {
    if (!deleteAccountConfirmation?.checked) {
      return
    }

    confirmDeleteAccount.disabled = true
    confirmDeleteAccount.textContent = "アカウントを削除しています..."

    deleteAccountMessage?.classList.add("hidden")

    try {
      const response = await fetch("/api/auth/delete", {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json",
        },
      })

      const data = await response.json().catch(() => null)

      if (!response.ok) {
        throw new Error(data?.error ?? "アカウントの削除に失敗しました。")
      }

      /*
       * The backend should invalidate the current session before
       * returning successfully.
       */

      window.location.href = "/login?deleted=true"
    } catch (error) {
      if (deleteAccountMessage) {
        deleteAccountMessage.textContent =
          error instanceof Error
            ? error.message
            : "アカウントの削除に失敗しました。"

        deleteAccountMessage.classList.remove("hidden")
      }

      confirmDeleteAccount.disabled = false
      confirmDeleteAccount.textContent = "アカウントを完全に削除"
    }
  })
</script>
