---
import AppLayout from "../layouts/AppLayout.astro"
import { requireAuth } from "../lib/require-auth"
import { apiFetch } from "../lib/api"

const user = await requireAuth(Astro)

if (user instanceof Response) {
  return user
}

let onboarding: {
  profile: {
    englishLevel: string
    studyTime: string
    onboardingCompleted: string | null
  } | null
  learningGoals: string[]
  interests: string[]
  examGoals: {
    exam: string
    toeicTargetScore: string | null
    eikenTargetGrade: string | null
  }[]
} | null = null

let preferences = {
  englishLevel: null as string | null,
  studyTime: null as string | null,
  learningGoals: [] as string[],
  interests: [] as string[],
  examGoals: [] as {
    exam: string
    toeicTargetScore: string | null
    eikenTargetGrade: string | null
  }[],
}

try {
  preferences = await apiFetch<{
    englishLevel: string | null
    studyTime: string | null
    learningGoals: string[]
    interests: string[]
    examGoals: {
      exam: string
      toeicTargetScore: string | null
      eikenTargetGrade: string | null
    }[]
  }>("/api/v1/settings/preferences", Astro)
} catch {
  // Keep defaults.
}

let connectedAccounts = {
  google: false,
  apple: false,
  line: false,
}

try {
  connectedAccounts = await apiFetch<{
    google: boolean
    apple: boolean
    line: boolean
  }>("/api/v1/auth/link/accounts", Astro)
} catch {
  // Continue without connected account information.
}

const googleAccount = connectedAccounts.google

try {
  onboarding = await apiFetch<{
    profile: {
      englishLevel: string
      studyTime: string
      onboardingCompleted: string | null
    } | null
    learningGoals: string[]
    interests: string[]
    examGoals: {
      exam: string
      toeicTargetScore: string | null
      eikenTargetGrade: string | null
    }[]
  }>("/api/v1/onboarding", Astro)
} catch {
  // Continue without onboarding data.
}

const profile = onboarding?.profile

const learningGoals = onboarding?.learningGoals ?? []

const examGoals = onboarding?.examGoals ?? []

const toeicGoal = examGoals.find((goal) => goal.exam === "toeic")

const eikenGoal = examGoals.find((goal) => goal.exam === "eiken")

const englishLevelLabels: Record<string, string> = {
  beginner: "初級",
  elementary: "初級（基礎）",
  intermediate: "中級",
  upper_intermediate: "中上級",
  advanced: "上級",
}

const studyTimeLabels: Record<string, string> = {
  "5": "5分",
  "10": "10分",
  "20": "20分",
  "30": "30分",
  "60": "60分",
  whenever: "時間があるとき",
}

const goalLabels: Record<string, string> = {
  toeic: "TOEIC",
  eiken: "英検",
  conversation: "英会話",
  business: "ビジネス英語",
  travel: "旅行英語",
  general: "一般英語",
}
---

<AppLayout title="設定" user={user}>
  <main class="mx-auto max-w-4xl px-6 py-10">
    <!-- HEADER -->

    <div class="mb-10">
      <a
        href="/dashboard"
        class="text-sm font-medium text-gray-500 transition hover:text-gray-900"
      >
        ← ダッシュボード
      </a>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900">設定</h1>

      <p class="mt-2 text-gray-500">
        アカウント、学習設定、練習に関する設定を管理できます。
      </p>
    </div>

    <!-- PROFILE -->

    <section class="rounded-2xl border bg-white p-6 sm:p-8">
      <div>
        <h2 class="text-xl font-bold text-gray-900">プロフィール</h2>

        <p class="mt-1 text-sm text-gray-500">アカウント情報。</p>
      </div>

      <div class="mt-6 divide-y">
        <div class="flex items-center justify-between gap-6 py-4 first:pt-0">
          <div>
            <p class="text-sm font-medium text-gray-500">名前</p>

            <p class="mt-1 font-semibold text-gray-900">
              {user.name || "未設定"}
            </p>
          </div>

          <button
            type="button"
            class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
          >
            編集
          </button>
        </div>

        <div class="flex items-center justify-between gap-6 py-4">
          <div>
            <p class="text-sm font-medium text-gray-500">メールアドレス</p>

            <p class="mt-1 font-semibold text-gray-900">
              {user.email}
            </p>
          </div>

          <button
            type="button"
            class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
          >
            編集
          </button>
        </div>
      </div>
    </section>

    <!-- CONNECTED ACCOUNTS -->

    <section class="mt-6 rounded-2xl border bg-white p-6 sm:p-8">
      <div>
        <h2 class="text-xl font-bold text-gray-900">連携済みアカウント</h2>

        <p class="mt-1 text-sm text-gray-500">
          外部アカウントを連携すると、より簡単にログインできます。
        </p>
      </div>

      <div class="mt-6 divide-y">
        <!-- GOOGLE -->

        <div
          class="flex flex-col gap-4 py-4 first:pt-0 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex items-center gap-4">
            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border bg-white text-lg font-bold"
            >
              G
            </div>

            <div>
              <p class="font-semibold text-gray-900">Google</p>

              {
                googleAccount ? (
                  <p class="mt-1 text-sm text-gray-500">
                    Googleアカウントが連携されています
                  </p>
                ) : (
                  <p class="mt-1 text-sm text-gray-500">未連携</p>
                )
              }
            </div>
          </div>

          {
            googleAccount ? (
              <button
                type="button"
                data-disconnect-provider="google"
                class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
              >
                連携を解除
              </button>
            ) : (
              <a
                href="/api/v1/auth/link/google"
                class="rounded-lg bg-gray-900 px-4 py-2 text-center text-sm font-semibold text-white transition hover:bg-gray-800"
              >
                連携する
              </a>
            )
          }
        </div>
      </div>

      <div
        id="connected-accounts-message"
        class="mt-4 hidden rounded-xl px-4 py-3 text-sm"
      >
      </div>
    </section>

    <!-- LEARNING PREFERENCES -->

    <section class="mt-6 rounded-2xl border bg-white p-6 sm:p-8">
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
      >
        <div>
          <h2 class="text-xl font-bold text-gray-900">学習設定</h2>

          <p class="mt-1 text-sm text-gray-500">
            あなたに合った学習体験を提供するための設定です。
          </p>
        </div>

        <button
          id="edit-preferences-button"
          type="button"
          class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
        >
          編集
        </button>
      </div>

      <div id="preferences-display" class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl bg-gray-50 p-5">
          <p
            class="text-xs font-semibold uppercase tracking-wide text-gray-400"
          >
            英語レベル
          </p>

          <p
            id="display-english-level"
            class="mt-2 font-semibold text-gray-900"
          >
            {
              preferences.englishLevel
                ? (englishLevelLabels[preferences.englishLevel] ??
                  preferences.englishLevel)
                : "未設定"
            }
          </p>
        </div>

        <div class="rounded-xl bg-gray-50 p-5">
          <p
            class="text-xs font-semibold uppercase tracking-wide text-gray-400"
          >
            1日の学習時間
          </p>

          <p id="display-study-time" class="mt-2 font-semibold text-gray-900">
            {
              preferences.studyTime
                ? (studyTimeLabels[preferences.studyTime] ??
                  preferences.studyTime)
                : "未設定"
            }
          </p>
        </div>

        <div class="rounded-xl bg-gray-50 p-5 sm:col-span-2">
          <p
            class="text-xs font-semibold uppercase tracking-wide text-gray-400"
          >
            学習目標
          </p>

          <div id="display-learning-goals" class="mt-3 flex flex-wrap gap-2">
            {
              preferences.learningGoals.length > 0 ? (
                preferences.learningGoals.map((goal) => (
                  <span class="rounded-full border bg-white px-3 py-1.5 text-sm font-medium text-gray-700">
                    {goalLabels[goal] ?? goal}
                  </span>
                ))
              ) : (
                <span class="font-semibold text-gray-900">未設定</span>
              )
            }
          </div>
        </div>

        <div class="rounded-xl bg-gray-50 p-5 sm:col-span-2">
          <p
            class="text-xs font-semibold uppercase tracking-wide text-gray-400"
          >
            興味・関心
          </p>

          <div id="display-interests" class="mt-3 flex flex-wrap gap-2">
            {
              preferences.interests.length > 0 ? (
                preferences.interests.map((interest) => (
                  <span class="rounded-full border bg-white px-3 py-1.5 text-sm font-medium text-gray-700">
                    {interest}
                  </span>
                ))
              ) : (
                <span class="font-semibold text-gray-900">未設定</span>
              )
            }
          </div>
        </div>
      </div>

      <div id="preferences-editor" class="mt-6 hidden space-y-6">
        <div>
          <label
            for="english-level"
            class="block text-sm font-semibold text-gray-900"
          >
            英語レベル
          </label>

          <select
            id="english-level"
            class="mt-2 w-full rounded-lg border-gray-300 bg-white px-3 py-2 text-sm sm:max-w-md"
          >
            {
              Object.entries(englishLevelLabels).map(([value, label]) => (
                <option
                  value={value}
                  selected={preferences.englishLevel === value}
                >
                  {label}
                </option>
              ))
            }
          </select>
        </div>

        <div>
          <label
            for="study-time"
            class="block text-sm font-semibold text-gray-900"
          >
            1日の学習時間
          </label>

          <select
            id="study-time"
            class="mt-2 w-full rounded-lg border-gray-300 bg-white px-3 py-2 text-sm sm:max-w-md"
          >
            {
              Object.entries(studyTimeLabels).map(([value, label]) => (
                <option
                  value={value}
                  selected={preferences.studyTime === value}
                >
                  {label}
                </option>
              ))
            }
          </select>
        </div>

        <div>
          <p class="text-sm font-semibold text-gray-900">学習目標</p>

          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {
              Object.entries(goalLabels).map(([value, label]) => (
                <label class="flex items-center gap-3 rounded-lg border p-3">
                  <input
                    type="checkbox"
                    name="learning-goal"
                    value={value}
                    checked={preferences.learningGoals.includes(value)}
                    class="rounded border-gray-300"
                  />
                  <span class="text-sm font-medium text-gray-700">{label}</span>
                </label>
              ))
            }
          </div>
        </div>

        <div>
          <label
            for="interests"
            class="block text-sm font-semibold text-gray-900"
          >
            興味・関心
          </label>

          <input
            id="interests"
            type="text"
            value={preferences.interests.join(", ")}
            placeholder="音楽、サッカー、テクノロジーなど"
            class="mt-2 w-full rounded-lg border-gray-300 px-3 py-2 text-sm"
          />

          <p class="mt-1 text-xs text-gray-500">
            複数ある場合は、カンマ（,）で区切ってください。
          </p>
        </div>

        <div class="flex justify-end gap-3 border-t pt-5">
          <button
            id="cancel-preferences-button"
            type="button"
            class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50"
          >
            キャンセル
          </button>

          <button
            id="save-preferences-button"
            type="button"
            class="rounded-lg bg-gray-900 px-5 py-2 text-sm font-semibold text-white hover:bg-gray-800"
          >
            変更を保存
          </button>
        </div>

        <div
          id="preferences-message"
          class="hidden rounded-lg px-4 py-3 text-sm"
        >
        </div>
      </div>
    </section>

    <!-- EXAM TARGETS -->

    <section class="mt-6 rounded-2xl border bg-white p-6 sm:p-8">
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
      >
        <div>
          <h2 class="text-xl font-bold text-gray-900">試験目標</h2>

          <p class="mt-1 text-sm text-gray-500">
            目標とするスコアや級を設定できます。
          </p>
        </div>

        <button
          id="edit-exam-targets-button"
          type="button"
          class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
        >
          編集
        </button>
      </div>

      <!-- DISPLAY -->

      <div id="exam-targets-display" class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border p-5">
          <div class="flex items-center justify-between">
            <p class="font-semibold text-gray-900">TOEIC</p>

            {
              toeicGoal?.toeicTargetScore && (
                <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">
                  目標
                </span>
              )
            }
          </div>

          <p class="mt-4 text-3xl font-bold text-gray-900">
            {toeicGoal?.toeicTargetScore ?? "—"}
          </p>

          <p class="mt-1 text-sm text-gray-500">目標スコア</p>
        </div>

        <div class="rounded-xl border p-5">
          <div class="flex items-center justify-between">
            <p class="font-semibold text-gray-900">英検</p>

            {
              eikenGoal?.eikenTargetGrade && (
                <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">
                  目標
                </span>
              )
            }
          </div>

          <p class="mt-4 text-3xl font-bold text-gray-900">
            {
              eikenGoal?.eikenTargetGrade
                ? eikenGoal.eikenTargetGrade.replace("_", " ")
                : "—"
            }
          </p>

          <p class="mt-1 text-sm text-gray-500">目標級</p>
        </div>
      </div>

      <!-- EDITOR -->

      <div id="exam-targets-editor" class="mt-6 hidden space-y-6">
        <!-- TOEIC -->

        <div>
          <label
            for="toeic-target-score"
            class="block text-sm font-semibold text-gray-900"
          >
            TOEIC目標スコア
          </label>

          <p class="mt-1 text-xs text-gray-500">
            10～990の範囲で目標スコアを設定してください。
          </p>

          <input
            id="toeic-target-score"
            type="number"
            min="10"
            max="990"
            step="5"
            value={toeicGoal?.toeicTargetScore ?? ""}
            placeholder="例：800"
            class="mt-3 w-full rounded-lg border-gray-300 px-3 py-2 text-sm sm:max-w-md"
          />
        </div>

        <!-- EIKEN -->

        <div>
          <label
            for="eiken-target-grade"
            class="block text-sm font-semibold text-gray-900"
          >
            英検目標級
          </label>

          <select
            id="eiken-target-grade"
            class="mt-3 w-full rounded-lg border-gray-300 bg-white px-3 py-2 text-sm sm:max-w-md"
          >
            <option value="">目標を設定しない</option>
            <option
              value="grade_5"
              selected={eikenGoal?.eikenTargetGrade === "grade_5"}
            >
              5級
            </option>
            <option
              value="grade_4"
              selected={eikenGoal?.eikenTargetGrade === "grade_4"}
            >
              4級
            </option>
            <option
              value="grade_3"
              selected={eikenGoal?.eikenTargetGrade === "grade_3"}
            >
              3級
            </option>
            <option
              value="pre_2"
              selected={eikenGoal?.eikenTargetGrade === "pre_2"}
            >
              準2級
            </option>
            <option
              value="pre_2_plus"
              selected={eikenGoal?.eikenTargetGrade === "pre_2_plus"}
            >
              準2級プラス
            </option>
            <option
              value="grade_2"
              selected={eikenGoal?.eikenTargetGrade === "grade_2"}
            >
              2級
            </option>
            <option
              value="pre_1"
              selected={eikenGoal?.eikenTargetGrade === "pre_1"}
            >
              準1級
            </option>
            <option
              value="grade_1"
              selected={eikenGoal?.eikenTargetGrade === "grade_1"}
            >
              1級
            </option>
          </select>
        </div>

        <div class="flex justify-end gap-3 border-t pt-5">
          <button
            id="cancel-exam-targets-button"
            type="button"
            class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50"
          >
            キャンセル
          </button>

          <button
            id="save-exam-targets-button"
            type="button"
            class="rounded-lg bg-gray-900 px-5 py-2 text-sm font-semibold text-white hover:bg-gray-800"
          >
            変更を保存
          </button>
        </div>

        <div
          id="exam-targets-message"
          class="hidden rounded-lg px-4 py-3 text-sm"
        >
        </div>
      </div>
    </section>

    <!-- ACCOUNT & SECURITY -->

    <section class="mt-6 rounded-2xl border bg-white p-6 sm:p-8">
      <div>
        <h2 class="text-xl font-bold text-gray-900">
          アカウントとセキュリティ
        </h2>
        <p class="mt-1 text-sm text-gray-500">
          パスワードやアカウントのセッションを管理します。
        </p>
      </div>

      <div class="mt-6 divide-y">
        <div class="flex items-center justify-between gap-6 py-4 first:pt-0">
          <div>
            <p class="font-semibold text-gray-900">パスワード</p>
            <p class="mt-1 text-sm text-gray-500">
              アカウントのパスワードを変更します。
            </p>
          </div>

          <button
            type="button"
            class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
          >
            パスワードを変更
          </button>
        </div>

        <div class="flex items-center justify-between gap-6 py-4">
          <div>
            <p class="font-semibold text-gray-900">ログアウト</p>
            <p class="mt-1 text-sm text-gray-500">
              現在のセッションからログアウトします。
            </p>
          </div>

          <a
            href="/logout"
            class="rounded-lg border px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
          >
            ログアウト
          </a>
        </div>
      </div>
    </section>

    <!-- DANGER ZONE -->

    <section class="mt-6 rounded-2xl border border-red-200 bg-white p-6 sm:p-8">
      <div>
        <h2 class="text-xl font-bold text-red-700">危険な操作</h2>

        <p class="mt-1 text-sm text-gray-500">
          これらの操作はアカウントに永久的な影響を与える可能性があります。
        </p>
      </div>

      <div
        class="mt-6 flex flex-col gap-4 rounded-xl border border-red-100 bg-red-50 p-5 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <p class="font-semibold text-gray-900">アカウントを削除</p>

          <p class="mt-1 text-sm text-gray-600">
            アカウントと関連するすべての学習データを完全に削除します。
          </p>
        </div>

        <button
          id="open-delete-account-modal"
          type="button"
          class="shrink-0 rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-100"
        >
          アカウントを削除
        </button>
      </div>
    </section>

    <!-- DELETE ACCOUNT MODAL -->

    <div
      id="delete-account-modal"
      class="fixed inset-0 z-50 hidden"
      aria-labelledby="delete-account-title"
      aria-modal="true"
      role="dialog"
    >
      <!-- Backdrop -->

      <div
        id="delete-account-backdrop"
        class="absolute inset-0 bg-black/50 backdrop-blur-sm"
      >
      </div>

      <!-- Modal -->

      <div class="relative flex min-h-full items-center justify-center p-4">
        <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl sm:p-8">
          <!-- Header -->

          <div>
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-red-100 text-red-700"
            >
              !
            </div>

            <h2
              id="delete-account-title"
              class="mt-5 text-xl font-bold text-gray-900"
            >
              アカウントを削除しますか？
            </h2>

            <p class="mt-2 text-sm leading-6 text-gray-600">
              この操作は永久的なもので、元に戻すことはできません。
            </p>
          </div>

          <!-- Warning -->

          <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4">
            <p class="text-sm font-semibold text-red-800">
              以下の情報が完全に削除されます：
            </p>

            <ul class="mt-3 space-y-2 text-sm leading-5 text-red-700">
              <li>• アカウントおよびプロフィール情報</li>
              <li>• 学習設定および興味・関心</li>
              <li>• TOEIC・英検の目標</li>
              <li>• 練習セッションおよび結果</li>
              <li>• 保存した単語および学習データ</li>
              <li>• 連携済みGoogle / OAuthアカウント情報</li>
              <li>• 現在ログイン中のセッション</li>
            </ul>
          </div>

          <p class="mt-5 text-sm leading-6 text-gray-600">
            アカウントを削除すると、データを復元することはできません。
          </p>

          <!-- Confirmation -->

          <label
            class="mt-6 flex cursor-pointer items-start gap-3 rounded-xl border p-4 transition hover:bg-gray-50"
          >
            <input
              id="delete-account-confirmation"
              type="checkbox"
              class="mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-red-600 focus:ring-red-500"
            />

            <span class="text-sm font-medium leading-5 text-gray-700">
              アカウントと関連するすべてのデータが完全に削除され、復元できないことを理解しました。
            </span>
          </label>

          <!-- Error -->

          <div
            id="delete-account-message"
            class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
          >
          </div>

          <!-- Actions -->

          <div
            class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
          >
            <button
              id="cancel-delete-account"
              type="button"
              class="rounded-lg border px-5 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-50"
            >
              キャンセル
            </button>

            <button
              id="confirm-delete-account"
              type="button"
              disabled
              class="rounded-lg bg-red-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-40"
            >
              アカウントを完全に削除
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 text-center">
      <a
        href="/dashboard"
        class="text-sm font-medium text-gray-500 transition hover:text-gray-900"
      >
        ← ダッシュボードに戻る
      </a>
    </div>
  </main>
</AppLayout>

<script>
  /*
   * ==========================================================================
   * 学習設定
   * ==========================================================================
   */

  const editPreferencesButton = document.getElementById(
    "edit-preferences-button",
  )

  const cancelPreferencesButton = document.getElementById(
    "cancel-preferences-button",
  )

  const savePreferencesButton = document.getElementById(
    "save-preferences-button",
  )

  const preferencesDisplay = document.getElementById("preferences-display")

  const preferencesEditor = document.getElementById("preferences-editor")

  const preferencesMessage = document.getElementById("preferences-message")

  editPreferencesButton?.addEventListener("click", () => {
    preferencesDisplay?.classList.add("hidden")
    preferencesEditor?.classList.remove("hidden")

    editPreferencesButton.classList.add("hidden")
  })

  cancelPreferencesButton?.addEventListener("click", () => {
    preferencesEditor?.classList.add("hidden")
    preferencesDisplay?.classList.remove("hidden")

    editPreferencesButton?.classList.remove("hidden")

    window.location.reload()
  })

  savePreferencesButton?.addEventListener("click", async () => {
    const englishLevel = (
      document.getElementById("english-level") as HTMLSelectElement
    )?.value

    const studyTime = (
      document.getElementById("study-time") as HTMLSelectElement
    )?.value

    const learningGoals = Array.from(
      document.querySelectorAll<HTMLInputElement>(
        'input[name="learning-goal"]:checked',
      ),
    ).map((input) => input.value)

    const interests = (
      document.getElementById("interests") as HTMLInputElement
    )?.value
      .split(",")
      .map((interest) => interest.trim())
      .filter(Boolean)

    if (learningGoals.length === 0) {
      if (preferencesMessage) {
        preferencesMessage.textContent = "学習目標を1つ以上選択してください。"

        preferencesMessage.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        preferencesMessage.classList.remove("hidden")
      }

      return
    }

    savePreferencesButton.setAttribute("disabled", "true")
    savePreferencesButton.textContent = "保存中..."

    try {
      const response = await fetch("/api/settings/preferences", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          englishLevel,
          studyTime,
          learningGoals,
          interests,
        }),
      })

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error ?? "学習設定の保存に失敗しました")
      }

      window.location.reload()
    } catch (error) {
      if (preferencesMessage) {
        preferencesMessage.textContent =
          error instanceof Error
            ? error.message
            : "学習設定の保存に失敗しました。"

        preferencesMessage.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        preferencesMessage.classList.remove("hidden")
      }

      savePreferencesButton.removeAttribute("disabled")
      savePreferencesButton.textContent = "変更を保存"
    }
  })

  /*
   * ==========================================================================
   * 試験目標
   * ==========================================================================
   */

  const editExamTargetsButton = document.getElementById(
    "edit-exam-targets-button",
  )

  const cancelExamTargetsButton = document.getElementById(
    "cancel-exam-targets-button",
  )

  const saveExamTargetsButton = document.getElementById(
    "save-exam-targets-button",
  )

  const examTargetsDisplay = document.getElementById("exam-targets-display")

  const examTargetsEditor = document.getElementById("exam-targets-editor")

  const examTargetsMessage = document.getElementById("exam-targets-message")

  editExamTargetsButton?.addEventListener("click", () => {
    examTargetsDisplay?.classList.add("hidden")

    examTargetsEditor?.classList.remove("hidden")

    editExamTargetsButton.classList.add("hidden")
  })

  cancelExamTargetsButton?.addEventListener("click", () => {
    window.location.reload()
  })

  saveExamTargetsButton?.addEventListener("click", async () => {
    const toeicTargetScore = (
      document.getElementById("toeic-target-score") as HTMLInputElement
    )?.value.trim()

    const eikenTargetGrade = (
      document.getElementById("eiken-target-grade") as HTMLSelectElement
    )?.value

    if (
      toeicTargetScore &&
      (Number(toeicTargetScore) < 10 ||
        Number(toeicTargetScore) > 990 ||
        !Number.isInteger(Number(toeicTargetScore)))
    ) {
      if (examTargetsMessage) {
        examTargetsMessage.textContent =
          "TOEICの目標スコアは10～990の範囲で設定してください。"

        examTargetsMessage.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        examTargetsMessage.classList.remove("hidden")
      }

      return
    }

    if (saveExamTargetsButton) {
      saveExamTargetsButton.setAttribute("disabled", "true")

      saveExamTargetsButton.textContent = "保存中..."
    }

    const examGoals: {
      exam: string

      toeicTargetScore?: string

      eikenTargetGrade?: string
    }[] = []

    if (toeicTargetScore) {
      examGoals.push({
        exam: "toeic",

        toeicTargetScore,
      })
    }

    if (eikenTargetGrade) {
      examGoals.push({
        exam: "eiken",

        eikenTargetGrade,
      })
    }

    try {
      const response = await fetch("/api/settings/exam-targets", {
        method: "PATCH",

        headers: {
          "Content-Type": "application/json",
        },

        body: JSON.stringify({
          examGoals,
        }),
      })

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.error ?? "試験目標の保存に失敗しました")
      }

      window.location.reload()
    } catch (error) {
      if (examTargetsMessage) {
        examTargetsMessage.textContent =
          error instanceof Error
            ? error.message
            : "試験目標の保存に失敗しました。"

        examTargetsMessage.className =
          "rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"

        examTargetsMessage.classList.remove("hidden")
      }

      saveExamTargetsButton?.removeAttribute("disabled")

      if (saveExamTargetsButton) {
        saveExamTargetsButton.textContent = "変更を保存"
      }
    }
  })

  const disconnectButtons = document.querySelectorAll(
    "[data-disconnect-provider]",
  )

  const message = document.getElementById("connected-accounts-message")

  disconnectButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const provider = button.getAttribute("data-disconnect-provider")

      if (!provider) {
        return
      }

      const confirmed = window.confirm(
        `${provider}アカウントとの連携を解除しますか？`,
      )

      if (!confirmed) {
        return
      }

      button.setAttribute("disabled", "true")

      try {
        const response = await fetch(`/api/v1/oauth/link/${provider}`, {
          method: "DELETE",
          credentials: "include",
        })

        const data = await response.json()

        if (!response.ok) {
          throw new Error(data.error ?? "アカウントの連携解除に失敗しました")
        }

        window.location.reload()
      } catch (error) {
        if (message) {
          message.textContent =
            error instanceof Error
              ? error.message
              : "アカウントの連携解除に失敗しました。"

          message.classList.remove("hidden")
          message.classList.add(
            "border",
            "border-red-200",
            "bg-red-50",
            "text-red-700",
          )
        }

        button.removeAttribute("disabled")
      }
    })
  })

  /*
   * ==========================================================================
   * アカウント削除
   * ==========================================================================
   */

  const openDeleteAccountModal = document.getElementById(
    "open-delete-account-modal",
  )

  const deleteAccountModal = document.getElementById("delete-account-modal")

  const deleteAccountBackdrop = document.getElementById(
    "delete-account-backdrop",
  )

  const cancelDeleteAccount = document.getElementById("cancel-delete-account")

  const deleteAccountConfirmation = document.getElementById(
    "delete-account-confirmation",
  ) as HTMLInputElement | null

  const confirmDeleteAccount = document.getElementById(
    "confirm-delete-account",
  ) as HTMLButtonElement | null

  const deleteAccountMessage = document.getElementById("delete-account-message")

  function openDeleteModal() {
    deleteAccountModal?.classList.remove("hidden")

    document.body.classList.add("overflow-hidden")

    deleteAccountConfirmation?.focus()
  }

  function closeDeleteModal() {
    deleteAccountModal?.classList.add("hidden")

    document.body.classList.remove("overflow-hidden")

    if (deleteAccountConfirmation) {
      deleteAccountConfirmation.checked = false
    }

    if (confirmDeleteAccount) {
      confirmDeleteAccount.disabled = true
      confirmDeleteAccount.textContent = "アカウントを完全に削除"
    }

    deleteAccountMessage?.classList.add("hidden")
  }

  openDeleteAccountModal?.addEventListener("click", () => {
    openDeleteModal()
  })

  cancelDeleteAccount?.addEventListener("click", () => {
    closeDeleteModal()
  })

  deleteAccountBackdrop?.addEventListener("click", () => {
    closeDeleteModal()
  })

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      if (!deleteAccountModal?.classList.contains("hidden")) {
        closeDeleteModal()
      }
    }
  })

  deleteAccountConfirmation?.addEventListener("change", () => {
    if (confirmDeleteAccount) {
      confirmDeleteAccount.disabled = !deleteAccountConfirmation.checked
    }
  })

  confirmDeleteAccount?.addEventListener("click", async () => {
    if (!deleteAccountConfirmation?.checked) {
      return
    }

    confirmDeleteAccount.disabled = true
    confirmDeleteAccount.textContent = "アカウントを削除しています..."

    deleteAccountMessage?.classList.add("hidden")

    try {
      const response = await fetch("/api/auth/delete", {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json",
        },
      })

      const data = await response.json().catch(() => null)

      if (!response.ok) {
        throw new Error(data?.error ?? "アカウントの削除に失敗しました。")
      }

      /*
       * The backend should invalidate the current session before
       * returning successfully.
       */

      window.location.href = "/login?deleted=true"
    } catch (error) {
      if (deleteAccountMessage) {
        deleteAccountMessage.textContent =
          error instanceof Error
            ? error.message
            : "アカウントの削除に失敗しました。"

        deleteAccountMessage.classList.remove("hidden")
      }

      confirmDeleteAccount.disabled = false
      confirmDeleteAccount.textContent = "アカウントを完全に削除"
    }
  })
</script>
